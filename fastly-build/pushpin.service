[Unit]
Description=pushpin
After=network.target
Before=pushpin-connmgr-in.service pushpin-connmgr-out.service pushpin-proxy.service pushpin-handler.service pushpin-stats-emitter.service pushpin-loader.service
Wants=pushpin-connmgr-in.service pushpin-connmgr-out.service pushpin-proxy.service pushpin-handler.service pushpin-stats-emitter.service pushpin-loader.service

[Service]
Type=simple
ExecStartPre=/opt/fst-pushpin/bin/pushpin-iptables.sh apply
ExecStart=/bin/true
ExecStopPost=/opt/fst-pushpin/bin/pushpin-iptables.sh rm
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
