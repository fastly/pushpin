[Unit]
Description=pushpin
After=network.target
Before=pushpin-socat.service pushpin-condure-in.service pushpin-condure-out.service pushpin-proxy.service pushpin-handler.service
Wants=pushpin-socat.service pushpin-condure-in.service pushpin-condure-out.service pushpin-proxy.service pushpin-handler.service

[Service]
Type=simple
ExecStartPre=/opt/fst-pushpin/bin/pushpin-iptables.sh apply
ExecStart=/bin/true
ExecStopPost=/opt/fst-pushpin/bin/pushpin-iptables.sh rm
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
