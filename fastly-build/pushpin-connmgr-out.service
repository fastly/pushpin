[Unit]
Description=pushpin-connmgr-out
PartOf=pushpin.service

[Service]
Type=simple
Restart=always
CPUQuota=400%
MemoryLimit=17G
LimitNOFILE=101000
SyslogIdentifier=pushpin-connmgr-out
Environment="RUST_BACKTRACE=1"
# let 1% of the connections use up to 8 write blocks
ExecStart=/opt/fst-pushpin/bin/pushpin-sandbox.sh /opt/fst-pushpin/bin/pushpin-connmgr --log-level=1 --zserver-stream ipc:///var/run/pushpin/pushpin-connmgr-client --workers 4 --buffer-size=16384 --stream-maxconn 100100 --blocks-max 207207 --connection-blocks-max 9 --compression --deny-out-internal --origind /var/run/origind/origind.sock --origind-rate 100 --debug-socket /var/run/pushpin/connmgr-out-debug,mode=770,user=pushpin,group=pushpin-debug --prometheus 127.0.0.1:1031,prefix=pushpin_

[Install]
WantedBy=multi-user.target
